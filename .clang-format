---
# real-esrguisoft 的 C++ 排版约定（clang-format）。
#
# 由仓库现有源码反推得到，不是从零发明：Tab 缩进（显示宽度 4）、Allman 大括号、
# 返回值独占一行、指针/引用靠类型名（East const 写法）、80 列换行、二元运算符
# 换行时前置。cxx_ci/standardize 与 cxx_audit 都读本文件；改动前先全仓跑一遍
# `standardize.py --check` 看 diff 规模，避免制造无关噪音。
#
# 本配置按 clang-format 20/21 编写（Linux 开发机为 21.1.8，Windows/MSYS2 用
# 同一代的 clang-format 即可）；换用更老的版本时 BreakAfterReturnType 需改写为
# 旧名 AlwaysBreakAfterReturnType。
Language: Cpp
BasedOnStyle: LLVM
Standard: c++17

# ---- 缩进与行宽 -----------------------------------------------------------
# 缩进用 Tab（宽度按 4 列算），续行/对齐优先用 Tab 填充、不足处补空格。
IndentWidth: 4
TabWidth: 4
UseTab: Always
ContinuationIndentWidth: 4
ColumnLimit: 80

# ---- 大括号与函数 ---------------------------------------------------------
# 左大括号独占一行（Allman）；函数返回类型与函数名分行（声明和定义一致），
# 空函数体允许写成 {}。
BreakBeforeBraces: Allman
BreakAfterReturnType: All
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false

# ---- 类型与命名空间 -------------------------------------------------------
# 指针/引用符号靠向变量名（const QString &v_path、AVFrame *v_frame）；
# 类体缩进 4 列，public:/private: 比类体少 2 列；namespace 体不缩进。
PointerAlignment: Right
ReferenceAlignment: Pointer
DerivePointerAlignment: false
AccessModifierOffset: -2
NamespaceIndentation: None
IndentCaseLabels: true

# ---- 花括号初始化、构造初始化列表 -----------------------------------------
# 花括号初始化列表内部保留空格（QStringList{ a, b }）；构造函数初始化列表
# 冒号独占续行（: Base(v_parent), m_x(v_x)）。
Cpp11BracedListStyle: false
SpaceBeforeCtorInitializerColon: true
BreakConstructorInitializers: BeforeColon
ConstructorInitializerIndentWidth: 4

# ---- 换行断点 -------------------------------------------------------------
# 二元运算符换行时放到下一行行首（= / && / || / + 同规则）；三目同理。
BreakBeforeBinaryOperators: All
BreakBeforeTernaryOperators: true
AlignAfterOpenBracket: Align
BinPackArguments: true
BinPackParameters: true
AlignTrailingComments: true
SpacesBeforeTrailingComments: 1

# ---- include 与注释 -------------------------------------------------------
# 不自动排序 include（工程按“自身头文件 → Qt → 标准库”人工分组，重排会改
# 依赖可见性）；不重排注释（大量中文注释与对齐的注释块会被打散）。
SortIncludes: Never
IncludeBlocks: Preserve
ReflowComments: false
MaxEmptyLinesToKeep: 1
FixNamespaceComments: true

# 长字符串（尤其中文）保持单行，不自动拆成相邻字面量拼接。
BreakStringLiterals: false
